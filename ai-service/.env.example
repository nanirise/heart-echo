# AI 服务本地配置模板。复制成 .env 后填值，.env 不入库。
#   cp ai-service/.env.example ai-service/.env

# 内部调用鉴权。必须与 backend/.env 的 AI_SERVICE_TOKEN 逐字相同，
# 不一致的表现是 Go 侧调用恒 401，且日志里看不出是配置问题（AGENTS §4.3）。
AI_SERVICE_TOKEN=change_me_but_keep_both_sides_equal

# 容器内必须监听 0.0.0.0，否则容器间连接被拒（AGENTS §4.10）。
HOST=0.0.0.0
PORT=8000
