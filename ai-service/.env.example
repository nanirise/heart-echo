# AI 服务本地配置模板。复制成 .env 后填值，.env 不入库。
#   cp ai-service/.env.example ai-service/.env

# 内部调用鉴权。必须与 backend/.env 的 AI_SERVICE_TOKEN 逐字相同，
# 不一致的表现是 Go 侧调用恒 401，且日志里看不出是配置问题（AGENTS §4.3）。
AI_SERVICE_TOKEN=change_me_but_keep_both_sides_equal

# 容器内必须监听 0.0.0.0，否则容器间连接被拒（AGENTS §4.10）。
HOST=0.0.0.0
PORT=8000

# DeepSeek。API Key 绝不入库（AGENTS §7 红线 1），找成员 1 要。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 单次生成的超时与输出上限。max_tokens 开发期调小，控制成本。
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# 朋友圈生成器档位：ai（默认）/ template（纯模板）。
# 注意：真正决定走哪档的是 Go 侧装配（backend/.env 的 MOMENT_GENERATOR）；
# 这里保留同名字段只为两侧 .env 可逐项对照。
MOMENT_GENERATOR=ai

# 记忆提取后端：rule（默认，正则）/ llm（DeepSeek 结构化提取）。
MEMORY_EXTRACT_BACKEND=rule

# 记忆召回后端：recent（阶段一，不注入记忆）/ vector（ChromaDB 语义检索）。
# 切 vector 前先启动 chromadb：本地起 deploy/docker-compose.dev.yml，整套容器起 deploy/docker-compose.yml。
MEMORY_BACKEND=recent
MEMORY_TOP_K=5

# ChromaDB。本地 uvicorn 连宿主机映射端口 8001（容器内部仍是 8000）。
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=persona_memories
