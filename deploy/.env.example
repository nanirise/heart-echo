# 生产环境变量模板：cp 成 deploy/.env 后填值（服务器上 chmod 600）。
# 两个消费方：compose 用 ${POSTGRES_*} 插值；env_file 把整个文件注入 backend / ai-service 容器。
# .env 永不入库（AGENTS §7 红线 1），仓库只留这份模板。

POSTGRES_USER=your_user_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=your_db_name

# 容器内服务名；backend 容器拿到的 DB_HOST 由 compose 注入，这里列出供人工核对
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT 密钥：≥32 字符、各环境不同，禁止用示例值上线；留空后端启动即失败（故意的）
JWT_SECRET=

# 内部调用令牌：必须与 ai-service 容器拿到的值完全一致，不一致表现为内部调用恒 401
AI_SERVICE_TOKEN=

# DeepSeek API Key（ai-service 调用大模型用）
DEEPSEEK_API_KEY=

# 定时任务间隔（Go 侧；放 ai-service 会静默失效）
# 朋友圈无手动触发接口，演示环境调到 2m 兜底
MOMENT_JOB_INTERVAL=30m
# 朋友圈生成器：ai（默认，调 ai-service，失败自动回退模板）/ template（纯模板）
MOMENT_GENERATOR=ai
# 主动消息与日程提醒共用
PROACTIVE_JOB_INTERVAL=5m

# 日程时间解析实现（rule | llm，P1）
SCHEDULE_PARSE_BACKEND=rule

# 情感分析后端：lexicon（阶段一词典，默认）/ onnx（阶段二，尚未实现）
EMOTION_BACKEND=lexicon

# ===== 阶段二：向量记忆 =====
# recent（回退档：不注入记忆）/ vector（ChromaDB 语义检索）
MEMORY_BACKEND=vector
MEMORY_TOP_K=5

# ai-service 容器连服务名 chromadb 的**内部**端口 8000（compose 会再覆盖一次）。
# CHROMA_HOST_PORT 只给 compose 做宿主机回环映射（调试用），应用不读取。
# 宿主机本地 uvicorn 调试时改用 CHROMA_HOST=localhost、CHROMA_PORT=8001。
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001
CHROMA_COLLECTION=persona_memories

# release 时日志转 JSON、只记 INFO 及以上
GIN_MODE=release

# 本地开发用；生产走 Nginx 同源代理，此项可留空
CORS_ALLOW_ORIGINS=
